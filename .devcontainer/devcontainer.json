{
  "name": "aivocode",
  "dockerComposeFile": ["docker-compose.yml"],
  "service": "devcontainer",
  "workspaceFolder": "/workspaces/aivocode",
  "shutdownAction": "none",
  "postCreateCommand": "mkdir -p ~/.ssh && ssh-keyscan github.com >> ~/.ssh/known_hosts 2>/dev/null",
  "postStartCommand": "micromamba run -n env-aivocode bash /workspaces/aivocode/cli/install.sh --venv /opt/aivocode-cli",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/conda/envs/env-aivocode/bin/python"
      }
    }
  }
}
